# Copy to `.env.local` (git-ignored) and fill in. Restart the dev server after.
#
# Only RESEND_API_KEY is required. Without it the contact form and quote wizard
# still validate and still refuse to fake success — they show the phone number
# instead, and the server logs why. Nothing else on the site depends on it.

# ── Lead delivery (contact form + quote wizard → /api/leads) ────────────────

# From https://resend.com/api-keys. Needs send permission only.
RESEND_API_KEY=

# Where leads land. Defaults to `site.contact.email` in src/content/site.ts,
# so leave this blank unless leads should go somewhere other than the address
# published on the site.
LEADS_TO_EMAIL=

# Who leads appear to come from. Defaults to Resend's shared sandbox sender,
# `onboarding@resend.dev`, which needs no DNS setup but WILL ONLY DELIVER TO
# THE EMAIL ADDRESS THE RESEND ACCOUNT WAS SIGNED UP WITH. That is fine while
# LEADS_TO_EMAIL is that same address, and it is a wall the moment it isn't.
#
# To lift it: verify a domain at https://resend.com/domains, then set this to
# an address on that domain, e.g.
#   LEADS_FROM_EMAIL="Ray's Website <leads@yourdomain.com>"
LEADS_FROM_EMAIL=
